<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.PatronViewController">

    <HBox>


        <VBox fx:id="table"/>

        <VBox>
            <TableView fx:id="tableBView" prefHeight="300" prefWidth="500">
                <columns>
                    <TableColumn fx:id="titleBColumn" prefWidth="150"/>
                    <TableColumn fx:id="authorBColumn" prefWidth="150"/>
                </columns>
            </TableView>
            <Button fx:id="btnOrder" onAction="#handleOrder" text="Place Order"/>


            <Label text="Borrowed Books"></Label>
            <TableView fx:id="borrowed" prefHeight="300" prefWidth="500">
                <columns>
                    <TableColumn fx:id="patronColumn" prefWidth="100"/>
                    <TableColumn fx:id="bookColumn" prefWidth="200"/>
                    <TableColumn fx:id="action2Column" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
