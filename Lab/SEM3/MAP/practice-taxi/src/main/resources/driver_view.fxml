<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.DriverViewController">
    <TableView fx:id="tableView" prefHeight="300" prefWidth="500">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="100"/>

            <TableColumn fx:id="startDateColumn" prefWidth="100"/>
            <TableColumn fx:id="endDateColumn" prefWidth="100"/>

            <TableColumn fx:id="statusColumn" prefWidth="100"/>

            <TableColumn fx:id="pickupColumn" prefWidth="100"/>
            <TableColumn fx:id="destinationColumn" prefWidth="100"/>
            <TableColumn fx:id="clientColumn" prefWidth="100"/>
            <TableColumn fx:id="actionColumn" prefWidth="100"/>


        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="prevButton" text="Prev" onAction="#onPrevPage"/>
        <Button fx:id="nextButton" text="Next" onAction="#onNextPage"/>
        <Label fx:id="pageLabel" text="Page: 1"/>
    </HBox>

</VBox>
