<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ui.controllers.FriendshipPagedViewController"
      spacing="20"
      prefWidth="800"
      alignment="TOP_CENTER">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <VBox HBox.hgrow="ALWAYS" spacing="15" alignment="TOP_CENTER">
        <TableView fx:id="tableView" prefHeight="300" prefWidth="400">
            <columns>
                <TableColumn fx:id="username1Column" text="Username" prefWidth="100"/>
                <TableColumn fx:id="id1Column" text="ID" prefWidth="100"/>

                <TableColumn fx:id="username2Column" text="Username" prefWidth="100"/>
                <TableColumn fx:id="id2Column" text="ID" prefWidth="100"/>

            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="prevButton" text="Prev" onAction="#onPrevPage"/>
            <Button fx:id="nextButton" text="Next" onAction="#onNextPage"/>
            <Label fx:id="pageLabel" text="Page: 1"/>
        </HBox>
    </VBox>

    <VBox spacing="15" alignment="TOP_CENTER" prefWidth="400" maxWidth="400">
        <TextField fx:id="id1Field" promptText="Id1"/>
        <TextField fx:id="id2Field" promptText="Id2"/>


        <HBox spacing="10">
            <Button text="Add Friendship" onAction="#addFriendship"/>
            <Button text="Clear" onAction="#clearForm"/>
            <Button text="Delete" onAction="#deleteFriendship"/>
        </HBox>

        <HBox spacing="10">
            <Button text="Communities nr" onAction="#communityNr"/>
            <Button text="Sociable" onAction="#mostSociable"/>

        </HBox>

    </VBox>
</HBox>