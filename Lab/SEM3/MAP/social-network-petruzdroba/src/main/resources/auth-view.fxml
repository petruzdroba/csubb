<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ui.controllers.AuthViewController"
      spacing="10" alignment="CENTER"
      stylesheets="@dark-theme.css"
      styleClass="root">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <Label text="Log In" styleClass="label-title"/>

    <TextField fx:id="emailField" promptText="Email" styleClass="text-field" maxWidth="420"/>

    <PasswordField fx:id="passwordField" promptText="Password" styleClass="password-field" maxWidth="420"/>

    <Button fx:id="loginButton" text="Login" styleClass="button" maxWidth="200" onAction="#logIn"/>

</VBox>
