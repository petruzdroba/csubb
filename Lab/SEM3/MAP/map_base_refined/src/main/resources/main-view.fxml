<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.EntityController">

    <TableView fx:id="entityTable" prefHeight="300" prefWidth="500">
        <columns>
            <TableColumn fx:id="nGazdaColumn" text="Gazda" prefWidth="100"/>
            <TableColumn fx:id="sGazdaColumn" prefWidth="50"/>
            <TableColumn fx:id="sOaspeteColumn" prefWidth="50"/>
            <TableColumn fx:id="nOaspeteColumn" text="Oaspete" prefWidth="100"/>

            <TableColumn fx:id="actionColumn" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
