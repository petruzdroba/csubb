<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.AdminAddController">
    <ComboBox fx:id="echipa" prefWidth="150.0" />

    <TextField fx:id="rata" promptText="rata 0-11" styleClass="number-field" maxWidth="420"/>

    <ComboBox fx:id="action" prefWidth="150.0" />

    <Button fx:id="submit" text="Add" styleClass="button" maxWidth="200" onAction="#handleSubmit"/>


</VBox>
