<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="011-add-index-employee-departament" author="lab5">
        <createIndex indexName="idx_employees_department"
                     tableName="employees">
            <column name="department_id"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_employees_department"
                       tableName="employees"/>
        </rollback>
    </changeSet>

    <changeSet id="012-add-index-employees-salary" author="lab5">
        <createIndex indexName="idx_employees_salary"
                     tableName="employees">
            <column name="salary"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_employees_salary"
                       tableName="employees"/>
        </rollback>
    </changeSet>


</databaseChangeLog>