<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="014-soft-delete-employees" author="lab5">
        <addColumn tableName="employees">
            <column name="is_deleted" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="deleted_by" type="VARCHAR(100)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="employees" columnName="is_deleted"/>
            <dropColumn tableName="employees" columnName="deleted_at"/>
            <dropColumn tableName="employees" columnName="deleted_by"/>
        </rollback>

    </changeSet>

</databaseChangeLog>