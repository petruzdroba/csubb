<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="moto_c.controllers.RacerViewController">
    <Grid ColumnDefinitions="250,Auto,*" Margin="10">

        <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Top">
            <TextBlock Text="Add Racer" FontWeight="Bold"/>
            <TextBox Name="nameField" Watermark="Name"/>
            <TextBox Name="cnpField" Watermark="CNP"/>
            <TextBox Name="engineField" Watermark="Engine"/>
            <ComboBox Name="teamFormComboBox" PlaceholderText="Select Team" HorizontalAlignment="Stretch"/>
            <Button Content="Save" Click="saveRacer" HorizontalAlignment="Stretch"/>

            <Separator/>

            <TextBlock Text="Modify Team" FontWeight="Bold"/>
            <TextBox Name="modifyNameField" Watermark="Name" IsEnabled="False"/>
            <TextBox Name="modifyCnpField" Watermark="CNP" IsEnabled="False"/>
            <TextBox Name="modifyEngineField" Watermark="Engine" IsEnabled="False"/>
            <ComboBox Name="modifyTeamComboBox" PlaceholderText="Select Team" HorizontalAlignment="Stretch"/>
            <Button Content="Modify" Click="modifyRacer" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <Separator Grid.Column="1" Width="2" Margin="10,0"/>

        <Grid Grid.Column="2" RowDefinitions="*,Auto" Margin="10,0,0,0">
            <Grid Grid.Row="0" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="0,0,0,5">
                    <TextBlock Grid.Column="0" Text="Name" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="CNP" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Engine" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="Team" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
                <ListBox Grid.Row="1" Name="racerList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,*,*,*">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Cnp}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Engine}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Team}" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                <TextBlock Text="Filter by Team:" VerticalAlignment="Center"/>
                <ComboBox Name="teamComboBox" PlaceholderText="Select Team"/>
                <Button Content="Search" Click="searchByTeam"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>