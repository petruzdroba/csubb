<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ui.controllers.ProfilePageViewController"
      spacing="20" alignment="TOP_CENTER"
      stylesheets="@dark-theme.css"
      styleClass="root">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 20;">
        <ImageView fx:id="profileImageView" fitWidth="100" fitHeight="100" preserveRatio="true">
            <clip>
                <Circle radius="50" centerX="50" centerY="50"/>
            </clip>
        </ImageView>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label fx:id="usernameLabel" styleClass="label-title"/>
            <Label fx:id="emailLabel" styleClass="user-info-label"/>
        </VBox>
    </HBox>

    <Button text="View Friends"
            fx:id="viewFriendsButton"
            onAction="#openFriendshipsWindow"
            maxWidth="300"
            styleClass="primary-button"/>

    <HBox fx:id="actionButtonsBox"
          spacing="15"
          alignment="CENTER">
        <Button fx:id="sendMessageButton"
                text="Send Message"
                styleClass="secondary-button"
                onAction="#handleSend"
                minWidth="140"/>
        <Button fx:id="requestButton"
                styleClass="secondary-button"
                onAction="#handleRequest"
                minWidth="140"/>
    </HBox>

</VBox>
