<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ui.controllers.MessageViewController"
      spacing="10" alignment="CENTER"
      stylesheets="@dark-theme.css"
      styleClass="root">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <HBox HBox.hgrow="ALWAYS" spacing="15" alignment="TOP_CENTER">
        <Button  fx:id="logOutButton" text="Log Out" onAction="#handleLogout"/>
        <Label fx:id="userLabel" text="User: " styleClass="label"/>
    </HBox>

</VBox>