<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ui.controllers.MessageViewController"
      spacing="10" alignment="CENTER"
      stylesheets="@dark-theme.css"
      styleClass="root">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <HBox spacing="15" alignment="TOP_CENTER">
        <Button fx:id="logOutButton" text="Log Out" onAction="#handleLogout"/>
        <Label fx:id="userLabel" text="User: " styleClass="user-info-label"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Send" onAction="#handleSend"/>
    </HBox>

    <SplitPane dividerPositions="0.35" VBox.vgrow="ALWAYS">

        <!-- mailuri -->
        <VBox>
            <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
                <Tab fx:id="receivedTab" text="Received"/>
                <Tab fx:id="sentTab" text="Sent"/>
            </TabPane>

            <ListView fx:id="messageListView" prefWidth="300" VBox.vgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="10">
                <Button fx:id="prevButton" text="Prev" onAction="#onPrevPage"/>
                <Button fx:id="nextButton" text="Next" onAction="#onNextPage"/>
                <Label fx:id="pageLabel" text="Page: 1"/>
            </HBox>
        </VBox>


        <!-- detalii -->
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <HBox spacing="5">
                <Label text="From:"/>
                <Label fx:id="fromLabel"/>
            </HBox>

            <HBox spacing="5">
                <Label text="To:"/>
                <Label fx:id="toLabel" wrapText="true"/>
            </HBox>

            <HBox spacing="5">
                <Label text="Date:"/>
                <Label fx:id="dateLabel"/>
            </HBox>

            <HBox spacing="5">
                <Label text="Reply To:"/>
                <Label fx:id="replyLabel" wrapText="true"/>
            </HBox>

            <Label text="Message:"/>
            <TextArea fx:id="messageBody"
                      editable="false"
                      wrapText="true"
                      prefRowCount="8"
                      VBox.vgrow="ALWAYS"/>

            <HBox spacing="15">
                <Button text="Reply" onAction="#handleReply"/>
                <Button text="Reply All" onAction="#handleReplyAll"/>
                <Button text="All Conversation" onAction="#showAllConveresation"/>

            </HBox>

        </VBox>

    </SplitPane>

</VBox>
